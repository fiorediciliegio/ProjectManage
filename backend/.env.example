PERF_SLOW_QUERY_MS=100
PERF_QUERY_WARN_COUNT=30
PERF_LOG_SAMPLE_RATE=1.0
PERF_LOG_PATH_PREFIXES=/projects/,/files/,/login/,/csrf/
PERF_LOG_LEVEL=INFO

EMBEDDING_PROVIDER=llama_cpp
